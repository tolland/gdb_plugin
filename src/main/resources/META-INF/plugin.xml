<idea-plugin>
    <id>org.limepepper.lang.gdb</id>
    <name>GDB Script Support</name>
    <vendor url="https://github.com/limepepper">limepepper</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <p>Provides support for GDB debugger script files, including syntax highlighting, formatting, and documentation.<br>
    <em>Supports .gdb file extension with comprehensive language features</em></p>
    <h2>Features</h2>
    <ul>
      <li>Syntax highlighting</li>
      <li>Code formatting</li>
      <li>Auto-completion of keywords</li>
      <li>Documentation</li>
      </ul>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.limepepper.lang.gdb.core</depends>


    <!-- syntax extensions -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="GDBScript"
            extensions="gdb"
        />
        <colorSettingsPage
            implementation="org.limepepper.lang.gdb.highlighting.GdbColorSettingsPage"
        />
        <!-- Disabled optional IDE features during lexer iteration
        <lang.psiStructureViewFactory language="GDBScript" implementationClass="org.limepepper.lang.gdb.structure.GdbStructureViewFactory"/>
        <annotator language="GDBScript" implementationClass="org.limepepper.lang.gdb.annotator.GdbAnnotator"/>
        <completion.contributor language="GDBScript" implementationClass="org.limepepper.lang.gdb.completion.GdbCompletionContributor"/>
        -->
    </extensions>
    <!-- doc provider extensions -->
    <extensions defaultExtensionNs="com.intellij.lang">
        <commenter
            language="GDBScript"
            implementationClass="org.limepepper.lang.gdb.commenter.GdbCommenter"
        />
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <platform.backend.documentation.targetProvider
            order="first"
            implementation="org.limepepper.lang.gdb.docs.GdbDocProvider"
        />
    </extensions>
        <!--    <platform.backend.documentation.psiTargetProvider order="first" implementation="org.limepepper.lang.gdb.documentation.GdbPsiDocProvider"/>-->
