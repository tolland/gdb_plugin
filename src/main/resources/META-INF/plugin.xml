<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
  <id>org.limepepper.gdb_plugin</id>

  <!-- Public plugin name should be written in Title Case.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
  <name>GDB Script Support</name>

  <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
  <vendor url="https://github.com/limepepper">limepepper</vendor>

  <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
  <description><![CDATA[
    Provides support for GDB debugger script files including syntax highlighting, formatting, and documentation.<br>
    <em>Supports .gdb file extension with comprehensive language features</em>
  ]]></description>

  <!-- Product and plugin compatibility requirements.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
  <depends>com.intellij.modules.platform</depends>

  <!-- Extension points defined by the plugin.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
  <extensions defaultExtensionNs="com.intellij">
    <!-- File type registration -->
    <fileType name="GDB Script"
              implementationClass="org.limepepper.gdb_plugin.GdbFileType"
              fieldName="INSTANCE"
              language="GDB"
              extensions="gdb"/>

    <!-- Syntax highlighting -->
    <lang.syntaxHighlighterFactory language="GDB"
                                   implementationClass="org.limepepper.gdb_plugin.highlighting.GdbSyntaxHighlighterFactory"/>

    <!-- Color settings page -->
    <colorSettingsPage implementation="org.limepepper.gdb_plugin.highlighting.GdbColorSettingsPage"/>

    <!-- Parser definition -->
    <lang.parserDefinition language="GDB"
                           implementationClass="org.limepepper.gdb_plugin.parser.GdbParserDefinition"/>

    <!-- Code formatting -->
    <lang.formatter language="GDB"
                    implementationClass="org.limepepper.gdb_plugin.formatting.GdbFormattingModelBuilder"/>

    <!-- Documentation target provider (modern API) -->
    <platform.backend.documentation.psiTargetProvider
            order="first"
            implementation="org.limepepper.gdb_plugin.documentation.GdbPsiDocProvider"/>

    <!-- Documentation target provider (modern API) -->
    <platform.backend.documentation.targetProvider
            order="first"
            implementation="org.limepepper.gdb_plugin.documentation.GdbDocProvider"/>
  </extensions>

  <!-- Actions -->
  <actions>
    <action id="org.limepepper.gdb_plugin.debug.DebugDocumentationAction"
            class="org.limepepper.gdb_plugin.debug.DebugDocumentationAction"
            text="Debug Documentation Providers"
            description="List all loaded PsiDocumentationTargetProviders in the log">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
