# Events - simplified for stub purposes
class Event:
    """Base class for GDB events."""
    pass

class StopEvent(Event):
    """Event fired when inferior stops."""
    pass

class BreakpointEvent(StopEvent):
    """Event fired when a breakpoint is hit."""
    
    @property
    def breakpoints(self) -> List['Breakpoint']: ...

class SignalEvent(StopEvent):
    """Event fired when inferior receives a signal."""
    
    @property
    def stop_signal(self) -> str: ...

class ExitedEvent(Event):
    """Event fired when inferior exits."""
    
    @property
    def exit_code(self) -> Optional[int]: ...

class ContinueEvent(Event):
    """Event fired when inferior continues."""
    pass

class NewObjFileEvent(Event):
    """Event fired when a new object file is loaded."""
    
    @property
    def new_objfile(self) -> 'Objfile': ...

class ClearObjFilesEvent(Event):
    """Event fired when object files are cleared."""
    
    @property
    def progspace(self) -> 'Progspace': ...

class NewInferiorEvent(Event):
    """Event fired when a new inferior is created."""
    
    @property
    def inferior(self) -> 'Inferior': ...

class InferiorDeletedEvent(Event):
    """Event fired when an inferior is deleted."""
    
    @property
    def inferior(self) -> 'Inferior': ...

class NewThreadEvent(Event):
    """Event fired when a new thread is created."""
    
    @property
    def inferior_thread(self) -> 'InferiorThread': ...

# Event registries (simplified)
class EventRegistry:
    """Base event registry."""
    
    def connect(self, callback: Callable[[Event], None]) -> None: ...
    def disconnect(self, callback: Callable[[Event], None]) -> None: ...

