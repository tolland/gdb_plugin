    @thread.setter
    def thread(self, value: Optional[int]) -> None: ...
    @property
    def task(self) -> Optional[int]: ...
    @task.setter
    def task(self, value: Optional[int]) -> None: ...
    @property
    def ignore_count(self) -> int: ...
    @ignore_count.setter
    def ignore_count(self, value: int) -> None: ...
    @property
    def number(self) -> int: ...
    @property
    def type(self) -> int: ...
    @property
    def visible(self) -> bool: ...
    @property
    def temporary(self) -> bool: ...
    @property
    def hit_count(self) -> int: ...
    @property
    def location(self) -> Optional[str]: ...
    @property
    def expression(self) -> Optional[str]: ...
    @property
    def condition(self) -> Optional[str]: ...
    @condition.setter
    def condition(self, value: Optional[str]) -> None: ...
    @property
    def commands(self) -> Optional[str]: ...
    @commands.setter
    def commands(self, value: Optional[str]) -> None: ...
    
    def is_valid(self) -> bool: ...
    def delete(self) -> None: ...
    
    def stop(self) -> bool:
        """Called when breakpoint is hit. Return True to stop."""
        ...

