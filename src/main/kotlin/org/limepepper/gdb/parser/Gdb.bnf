{

  elementTypeClass="org.limepepper.gdb.psi.GdbElementType"
  elementTypeHolderClass="org.limepepper.gdb.psi.GdbTypes"
  extends='org.limepepper.gdb.psi.GdbPsiElement'
//  implements = 'org.limepepper.gdb.psi.GdbPsiElement'
  parserClass="org.limepepper.gdb.parser.GdbParser"
  parserUtilClass = "org.limepepper.gdb.parser.GdbParserUtil"
  psiClassPrefix="Gdb"
  psiImplClassSuffix="Impl"
  psiImplPackage="org.limepepper.gdb.psi.impl"
  psiImplUtilClass="org.limepepper.gdb.psi.impl.GdbPsiImplUtil"
  psiPackage="org.limepepper.gdb.psi"
  tokenTypeClass="org.limepepper.gdb.psi.GdbTokenType"

  tokens=[

    PYTHON_KW = 'python'
    GUILE_KW = 'guile'
    DOC_BLOCK = 'regexp:document\n.*?(end\b)'
    PYTHON_BLOCK = 'regexp:python\n.*?(end\b)'
    GUILE_BLOCK = 'regexp:guile\n.*?(end\b)'
    ARGS_BLOCK = 'regexp:args\n.*?(end\b)'

    // Special-case command keywords ---
    SET_KW           = 'set'
    PRINT_KW         = 'print'
    DEFINE           = 'define'
    END              = 'end'
    COMMANDS         = 'commands'



    // Basic commands (without x, print, p, break, b)
    COMMAND_EXECUTION='regexp:(run|r|start|continue|c|step|s|next|n|finish|until|u|kill|quit|q|detach)'
    COMMAND_BREAKPOINT='regexp:(b|br|bre|brea|break|tb|tbr|tbre|tbreak|hbreak|thbreak|rbreak|watch|rwatch|awatch|catch|delete|enable|disable|condition)'
    COMMAND_STACK='regexp:(backtrace|bt|frame|f|up|down|select-frame)'
    COMMAND_DATA='regexp:(display|output|printf|call|return|examine|info|i|show|list|l|disassemble|disas)'
    COMMAND_CONFIG='regexp:(unset|source|exec-file|symbol-file|core-file|target|attach|load)'
    // COMMAND_USER='regexp:(d|if|else|while|loop_break|loop_continue)'

    // Structural tokens
    WHITE_SPACE       = 'regexp:[ \t]'
    COMMENT          = 'regexp:#[^\r\n]*'
    LINE_CONTINUATION = 'regexp:\\\\(\r\n|\n|\r)'
    CRLF             = 'regexp:(\r\n|\n|\r)'

    // Literals
    HEX_NUMBER='regexp:0x[0-9a-fA-F]+'
//    VARIABLE = 'regexp:\$[a-zA-Z_][a-zA-Z0-9_]*'
    REGISTER='regexp:\$[a-zA-Z_][a-zA-Z0-9_]*|\$\d+'
    NUMBER='regexp:\d+'
    IDENTIFIER='regexp:[a-zA-Z_][a-zA-Z0-9_]*'
    STRING='regexp:"([^"\\]|\\.)*"'

    // strings
    DOUBLE_QUOTED_STRING="regexp:\"([^\\\"\r\n]|\\[^\r\n])*\"?"

    // Punctuation
    ARROW='->'
    COLON=':'
    COMMA=','
    DOT='.'
    OP_EQUAL='=='
    OP_ASSIGN='='
    LBRACE='{'
    LBRACKET='['
    LPAREN='('
    OP_DIV='/'
    OP_ELLIPSIS='...'
    OP_GREATER_OR_EQUAL='>='
    OP_GREATER='>'
    OP_LESS_OR_EQUAL='<='
    OP_LESS='<'
    RBRACE='}'
    RBRACKET=']'
    RPAREN=')'
    SEMICOLON=';'
    OP_AND_AND='&&'
    OP_OR_OR='||'
    OP_PIPE='|'

    // Operators
    OP_PLUS='+'
    OP_MINUS='-'
    OP_MUL='*'
    OP_DIV='/'
    OP_MOD='%'

    SINGLE_QUOTE="'"
    SCOPE_RESOLUTION='::'
    WORD             = 'regexp:[^#\s\\]+'
  ]
}

gdbFile ::= statement*

// --- THE NEW, UNAMBIGUOUS DISPATCHER ---
// A statement is now one of three things, based on what it starts with.
private statement ::= (comment_driven_statement | command_statement | CRLF)


// --- 1. A STATEMENT THAT STARTS WITH A COMMENT ---
// We figure out what KIND of comment block it is here.
private comment_driven_statement ::= (documented_command | floating_comment | doc_comment_block)

// An ATTACHED command: a doc block, a predicate ensuring NO blank line, and the command itself.
// This is now a top-level structure.
documented_command ::= doc_comment_block &(!CRLF) command_statement

// A FLOATING comment: a doc block FOLLOWED by a blank line.
floating_comment ::= doc_comment_block CRLF

// A TRAILING comment (or standalone): just a doc block.
// The parser will only choose this if the rules above fail.
doc_comment_block ::= (COMMENT CRLF)+

// ================== Structural Rules ==================

// --- 2. A STATEMENT THAT STARTS WITH A COMMAND WORD ---
// This rule now ONLY matches commands that are NOT preceded by a comment.
// All doc-comment logic has been removed from here.
command_statement ::= (define_block | command)
{
  methods=[getKey]
}
// {mixin="org.limepepper.gdb.psi.impl.GdbNamedElementImpl" implements=["org.limepepper.gdb.psi.GdbNamedElement" "com.intellij.navigation.NavigationItem"]}


// ================== CORE COMMAND RULES (NOW SIMPLIFIED) ==================
// These rules are now simple because they don't worry about doc comments.

define_block ::= DEFINE WORD+ CRLF statement* END CRLF?

command ::= (set_print_command | normal_command)

private set_print_command ::= set_print_command_line commands_block? {pin=1}
private normal_command ::= normal_command_line commands_block? {pin=1}

// A command line for 'set' or 'print'.
// The key is `(WORD | COMMENT)*`: it consumes the entire rest of the line,
// treating COMMENT tokens as just another part of the arguments.
private set_print_command_line ::= (SET_KW | PRINT_KW)
                                   ((IDENTIFIER | REGISTER | OP_ASSIGN | COMMENT) &(!CRLF))*
                                    value_statement
                                   CRLF {pin=1}

value_statement ::= HEX_NUMBER | NUMBER | STRING | IDENTIFIER | WORD
//value ::= VARIABLE | NUMBER | STRING | IDENTIFIER

simple_command ::= COMMAND_EXECUTION
         | COMMAND_BREAKPOINT
         | COMMAND_STACK
         | COMMAND_DATA
         | COMMAND_CONFIG
         | COMMAND_USER

// A command line for any other command.
// The key is `(COMMENT)?`: it allows an OPTIONAL
// separate COMMENT at the very end.
private normal_command_line ::= simple_command+
                                ((IDENTIFIER | WORD) &(!CRLF))*
                                (COMMENT)? CRLF

// A 'commands' block that attaches to a preceding command.
private commands_block ::= COMMANDS CRLF statement* END CRLF?
